<% provide(:title, "案件登録") %>
<div class="container form-container">
  <h1 class="form-header">案件の登録</h1>
  <%= form_with(model: @project) do |p| %>
    <div>
      <%= p.label :client, "クライアント" %>
      <%= p.text_field :client, required: true %>
    </div>
    <div>
      <%= p.label :keyword, "案件名（キーワード等）" %>
      <%= p.text_field :keyword, required: true %>
    </div>
    <div>
      <%= p.label :process, "工程" %>
      <%= p.text_field :process, required: true %>
    </div>
    <div>
      <%= p.submit "登録" %>
    </div>
  <% end %>
  <%= link_to "タスク一覧に戻る", projects_path, class: "black-link new-to-projects" %>
</div>
