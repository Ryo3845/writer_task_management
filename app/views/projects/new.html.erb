<% provide(:title, "案件登録") %>
<div class="container project-registration-container">
  <h1>案件の登録</h1>
  <%= form_with(model: @project) do |p| %>
    <div>
      <%= p.label :client, "クライアント" %>
      <%= p.text_field :client, required: true %>
    </div>
    <div>
      <%= p.label :keyword, "案件名（キーワード等）" %>
      <%= p.text_field :keyword, required: true %>
    </div>
    <div>
      <%= p.label :rewards, "報酬" %>
      <%= p.text_field :rewards %>
    </div>
    <%= p.fields_for :tasks do |t| %>
      <div>
        <%= t.label :task, "タスク" %>
        <%= t.text_field :task %>
      </div>
      <div>
        <%= t.label :due_date, "タスクの期日" %>
        <%= t.text_field :due_date %>
      </div>
      <div>
        <%= t.label :task_url, "タスクのURL" %>
        <%= t.url_field :task_url %>
      </div>
      <div>
        <%= t.label :notes, "タスクのメモ" %>
        <%= t.text_field :notes %>
      </div>
    <% end %>
    <div>
      <%= p.submit "登録" %>
    </div>
  <% end %>
  <%= link_to "タスク一覧に戻る", projects_path, class: "black-link new-to-projects" %>
</div>