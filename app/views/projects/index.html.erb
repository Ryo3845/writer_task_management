<% provide(:title, "案件管理") %>
<%= @all_processes %>
<div class="container project-container">
  <div id="delivery-date-alert">
    <div class="today-deadline-container">
      <span>本日が納期のタスク</span>
      <div>○○</div>
    </div>
    <div class="this-week-container">
      <span>今週が納期のタスク</span>
      <div>○○</div>
    </div>
    <div class="delay-container">
      <span>遅延しているタスク</span>
      <div>○○</div>
    </div>
  </div>
  <div id="project-main-container">
    <div id="project-second-container">
      <%= link_to new_project_path, id: "project-registration-character" do %>
        <div class="task-registration">
          <%= image_tag("add_task", alt: "案件登録", width: 18, height: 18, id: "add_project") %>
          案件登録
        </div>
      <% end %>
      <div id="project-third-container">
        <%= image_tag("search", alt: "案件検索", width: 21, height: 21, id: "project_search") %>
        <input type="text">
      </div>
    </div>
    <table class="project-table-header project-table">
      <tr>
        <th class="task-completed task-header"></th>
        <th class="task task-header">タスク</th>
        <th class="due-date task-header">期日</th>
        <th class="status task-header">ステータス</th>
        <th class="time-spent task-header">費やした時間</th>
        <th class="task_url task-header">URL</th>
        <th class="notes task-header">メモ</th>
      </tr>
    </table>
    <% @always_visible_projects.each do |p| %>
      <div class="project-section">
        <div class="project-info-row">
          <div class="project-info-cell">案件名：<%= p.project %></div>
          <div class="project-info-cell">クライアント：<%= p.client %></div>
          <div class="project-info-cell">報酬：<%= number_to_currency(p.rewards) %></div>
        </div>
        <table class="project-table">
          <% p.tasks.each do |t| %>
            <tr>
              <td class="task-completed task-cell"><%= image_tag("no_completed", alt: "タスク未完了", width: 22, height: 22, id: "task-completed") %></td>
              <td class="task task-cell"><%= t.task %></td>
              <td class="due-date task-cell">
                <%= form_with model: t, local: true do |f| %>
                  <%= f.date_field :due_date %>
                <% end %>
              </td>
              <td class="status task-cell">
                <%= form_with model: t, local: true do |f| %>
                  <%= f.collection_select :status, @tasks, :id, :status %>
                <% end %>
              </td>
              <td class="time-spent task-cell">
              </td>
              <td class="task_url task-cell">
                <% if t.task_url.present? %>
                  <%= link_to image_tag("open_in_new", alt: "新しくリンクを開く", width: 22, height: 22), t.task_url, target: "_blank", rel: "noopener nofollow noreferrer" %>
                  <%= link_to t.task_url, t.task_url, target: "_blank", rel: "noopener nofollow noreferrer", id: "task_url_character" %>
                <% end %>
              </td>
              <td class="notes task-cell"><%= t.notes %></td>
            </tr>
          <% end %>
        </table>
      </div>
    <% end %>
    <% @conditional_projects.each do |p| %>
      <div class="project-section">
        <div class="project-info-row">
          <div class="project-info-cell">案件名：<%= p.project %></div>
          <div class="project-info-cell">クライアント：<%= p.client %></div>
          <div class="project-info-cell">報酬：<%= number_to_currency(p.rewards) %></div>
        </div>
        <table class="project-table">
          <% p.tasks.each do |t| %>
            <tr class="task-row">
              <td class="task-completed task-cell"><%= image_tag("no_completed", alt: "タスク未完了", width: 22, height: 22, id: "task-completed") %></td>
              <td class="task task-cell"><%= t.task %></td>
              <td class="due-date task-cell"><%= t.due_date %></td>
              <td class="status task-cell"></td>
              <td class="time-spent task-cell"></td>
              <td class="task_url task-cell"></td>
              <td class="notes task-cell"><%= t.notes %></td>
            </tr>
          <% end %>
        </table>
      </div>
    <% end %>
  </div>
</div>
