<% provide(:title, "案件管理") %>
<%= @all_processes %>
<div class="container project-container">
  <div id="delivery-date-alert">
    <div class="today-deadline-container">
      <span>本日が納期のタスク</span>
      <div>○○</div>
    </div>
    <div class="this-week-container">
      <span>今週が納期のタスク</span>
      <div>○○</div>
    </div>
    <div class="delay-container">
      <span>遅延しているタスク</span>
      <div>○○</div>
    </div>
  </div>
  <div id="project-main-container">
    <div id="project-second-container">
      <%= link_to new_project_path, id: "project-registration-character" do %>
        <div class="task-registration">
          <%= image_tag("add_task", alt: "案件登録", width: 18, height: 18, id: "add_project") %>
          案件登録
        </div>
      <% end %>
      <div id="project-third-container">
        <%= image_tag("search", alt: "案件検索", width: 21, height: 21, id: "project_search") %>
        <input type="text">
      </div>
    </div>
    <table class="project-table">
      <tr>
        <th class="zoom-in"></th>
        <th class="client">クライアント</th>
        <th class="keyword">案件名（キーワード等）</th>
        <th class="due-date">納期</th>
        <th class="remaining-days">残り日数</th>
        <th class="rewards">報酬</th>
      </tr>
      <% @projects.each do |p| %>
        <tr>
          <td class="zoom-in"><%= link_to image_tag("zoom_in", alt: "案件の詳細", width: 22, height: 22, id: "zoom-in-image"), p %></td>
          <td class="client"><%= p.client %></td>
          <td class="keyword"><%= p.keyword %></td>
          <td class="due-date"></td>
          <td class="remaining-days"></td>
          <td class="rewards"><%= number_to_currency(p.rewards) %></td>
        </tr>
      <% end %>
    </table>
  </div>
</div>
<div id="deal-registration">
  <div></div>
</div>
