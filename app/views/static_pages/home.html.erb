<div class="home-container">
  <% if logged_in? %>
    <%= render 'projects/index' %>
  <% else %>
    <h1>ライター・編集者案件管理ツール（仮）</h1>
    <p>ライター・編集者が案件を管理できるツールです。</p>
    <div class="header-hamburger-menu">
      <li><%= link_to "ログイン", login_path %></li>
      <li><%= link_to "新規登録", signup_path %></li>
    </div>
  <% end %>
</div>
